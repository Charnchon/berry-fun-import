<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<title>Imposter Game</title>
<style>
  body {
    font-family: sans-serif;
    text-align: center;
    padding: 30px;
    background: #f7f7f7;
  }
  .card {
    background: white;
    padding: 30px;
    border-radius: 20px;
    max-width: 500px;
    margin: auto;
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
  }
  button {
    padding: 12px 20px;
    margin: 10px;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    background: #007bff;
    color: white;
    font-size: 16px;
  }
  #word {
    font-size: 28px;
    margin: 20px 0;
    font-weight: bold;
  }
</style>
</head>
<body>

<div class="card">
  <h1>Imposter Game</h1>

  <label>จำนวนผู้เล่น:</label>
  <input type="number" id="players" value="5"><br><br>

  <label>จำนวน Imposter:</label>
  <input type="number" id="imposters" value="1"><br><br>

  <button onclick="startGame()">เริ่มเกม</button>

  <div id="game" style="display:none;">
    <h2 id="playerTurn"></h2>
    <button onclick="showWord()">เปิดดูคำ</button>
    <div id="word"></div>
    <button onclick="nextPlayer()">คนถัดไป</button>
  </div>
</div>

<script>
const words = [
  "deadline", "กาแฟ", "ทะเล", "ความลับ",
  "โทรศัพท์", "แมว", "เงินเดือน", "ฝน"
];

let playerRoles = [];
let currentPlayer = 0;
let secretWord = "";

function startGame() {
  const players = parseInt(document.getElementById("players").value);
  const imposters = parseInt(document.getElementById("imposters").value);

  secretWord = words[Math.floor(Math.random() * words.length)];
  playerRoles = Array(players).fill(secretWord);

  let chosen = [];
  while (chosen.length < imposters) {
    let rand = Math.floor(Math.random() * players);
    if (!chosen.includes(rand)) {
      chosen.push(rand);
      playerRoles[rand] = "IMPOSTER";
    }
  }

  currentPlayer = 0;
  document.getElementById("game").style.display = "block";
  updateTurn();
}

function updateTurn() {
  document.getElementById("playerTurn").innerText =
    `ผู้เล่นคนที่ ${currentPlayer + 1}`;
  document.getElementById("word").innerText = "";
}

function showWord() {
  const role = playerRoles[currentPlayer];
  document.getElementById("word").innerText =
    role === "IMPOSTER" ? "😈 คุณคือ IMPOSTER" : `คำคือ: ${role}`;
}

function nextPlayer() {
  currentPlayer++;
  if (currentPlayer >= playerRoles.length) {
    alert("แจกคำครบแล้ว เริ่มเล่นได้!");
    document.getElementById("game").style.display = "none";
  } else {
    updateTurn();
  }
}
</script>

</body>
</html>
